generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------- ENUMS -----------

enum TipoCuenta {
  EFECTIVO
  BANCO
  TARJETA_CREDITO
  OTRO
}

enum TipoCategoria {
  INGRESO
  GASTO
}

enum TipoTransaccion {
  INGRESO
  GASTO
}

enum FrecuenciaRecurrencia {
  SEMANAL
  MENSUAL
  ANUAL
}

// ------------ MODELOS -------------- 

model Usuario {
  id                 String    @id @default(uuid())
  nombre             String
  correo             String    @unique
  contrasenaHash     String    @map("contrasena_hash")
  fechaCreacion      DateTime  @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime  @updatedAt @map("fecha_actualizacion")

  cuentas        Cuenta[]
  categorias     Categoria[]
  transacciones  Transaccion[]
  presupuestos   Presupuesto[]
  metasAhorro    MetaAhorro[]

  @@map("usuarios")
}

model Cuenta {
  id                 String    @id @default(uuid())
  idUsuario          String    @map("id_usuario")
  nombre             String
  tipo               TipoCuenta
  saldoInicial       Decimal   @default(0) @map("saldo_inicial")
  fechaCreacion      DateTime  @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime  @updatedAt @map("fecha_actualizacion")

  usuario        Usuario        @relation(fields: [idUsuario], references: [id], onDelete: Restrict)
  transacciones  Transaccion[]

  @@map("cuentas")
}

model Categoria {
  id              String    @id @default(uuid())
  idUsuario       String?   @map("id_usuario")
  nombre          String
  tipo            TipoCategoria
  esPredefinida   Boolean   @default(false) @map("es_predefinida")
  fechaCreacion   DateTime  @default(now()) @map("fecha_creacion")

  usuario        Usuario?       @relation(fields: [idUsuario], references: [id], onDelete: Restrict)
  transacciones  Transaccion[]
  presupuestos   Presupuesto[]

  @@map("categorias")
}

model Transaccion {
  id                    String                 @id @default(uuid())
  idUsuario             String                 @map("id_usuario")
  idCuenta              String                 @map("id_cuenta")
  idCategoria           String                 @map("id_categoria")
  tipo                  TipoTransaccion
  monto                 Decimal
  descripcion           String?
  fecha                 DateTime
  esRecurrente          Boolean                @default(false) @map("es_recurrente")
  frecuenciaRecurrencia FrecuenciaRecurrencia? @map("frecuencia_recurrencia")
  fechaCreacion         DateTime               @default(now()) @map("fecha_creacion")
  fechaActualizacion    DateTime               @updatedAt @map("fecha_actualizacion")

  usuario  Usuario   @relation(fields: [idUsuario], references: [id], onDelete: Restrict)
  cuenta   Cuenta    @relation(fields: [idCuenta], references: [id], onDelete: Restrict)
  categoria Categoria @relation(fields: [idCategoria], references: [id], onDelete: Restrict)

  @@index([idUsuario, fecha])
  @@index([idCuenta])
  @@index([idCategoria])
  @@map("transacciones")
}

model Presupuesto {
  id              String   @id @default(uuid())
  idUsuario       String   @map("id_usuario")
  idCategoria     String   @map("id_categoria")
  montoLimite     Decimal  @map("monto_limite")
  mes             Int
  anio            Int
  fechaCreacion   DateTime @default(now()) @map("fecha_creacion")

  usuario   Usuario   @relation(fields: [idUsuario], references: [id], onDelete: Restrict)
  categoria Categoria @relation(fields: [idCategoria], references: [id], onDelete: Restrict)

  @@unique([idUsuario, idCategoria, mes, anio])
  @@map("presupuestos")
}

model MetaAhorro {
  id              String   @id @default(uuid())
  idUsuario       String   @map("id_usuario")
  nombre          String
  montoObjetivo   Decimal  @map("monto_objetivo")
  montoActual     Decimal  @default(0) @map("monto_actual")
  fechaObjetivo   DateTime @map("fecha_objetivo")
  fechaCreacion   DateTime @default(now()) @map("fecha_creacion")

  usuario  Usuario      @relation(fields: [idUsuario], references: [id], onDelete: Restrict)
  aportes  AporteMeta[]

  @@map("metas_ahorro")
}

model AporteMeta {
  id            String   @id @default(uuid())
  idMeta        String   @map("id_meta")
  monto         Decimal
  fecha         DateTime
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  meta MetaAhorro @relation(fields: [idMeta], references: [id], onDelete: Cascade)

  @@map("aportes_meta")
}
